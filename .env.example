# Build worker settings. Copy to .env (never commit .env).
# FIFO build queue from thrico-logic (group "builds"); messages carry ids only.
CUSTOM_APP_BUILD_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/<queue>.fifo
# AWS credentials that can receive, delete and change visibility on that queue (or use an AWS profile).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# thrico-logic base URL serving /worker/builds/:id/{bundle,report,logs}; this Mac's IP must be on its admin allowlist.
THRICO_API_URL=
# Same value as BUILD_WORKER_TOKEN on thrico-logic (32+ characters).
BUILD_WORKER_TOKEN=
# Whole-build time limit; the build fails and cleans up after this.
BUILD_TIME_LIMIT_MINUTES=120

# Baked into every white-label app build.
APP_GOOGLE_MAPS_API_KEY=
APP_SENTRY_DSN=
APP_API_URL=https://prod-mobile.thrico.app/graphql
APP_WS_URL=wss://prod-mobile.thrico.app/graphql

